Vagrant.configure("2") do |config|
  # 1. Перша віртуальна машина на базі Ubuntu 20.04 (з підтримкою VMware)
  config.vm.define "ubuntu_vm" do |ubuntu|
    ubuntu.vm.box = "bento/ubuntu-20.04"
    ubuntu.vm.provider "vmware_desktop" do |v|
      v.memory = "2048"
      v.cpus = 2
    end
  end

  # 2. Друга віртуальна машина на базі Debian 11 (з підтримкою VMware)
  config.vm.define "debian_vm" do |debian|
    debian.vm.box = "bento/debian-11"
    debian.vm.provider "vmware_desktop" do |v|
      v.memory = "1024"
      v.cpus = 1
    end
  end
end